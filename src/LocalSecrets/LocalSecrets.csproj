<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>secret</AssemblyName>
    <RootNamespace>LocalSecrets</RootNamespace>
    <Version>0.2.2</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- win-x64 par défaut ; build.ps1 -Linux passe -r linux-x64. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <!-- Exécutable natif autonome : pas besoin du runtime .NET chez les collègues, démarrage rapide pour les hooks. -->
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Speed</OptimizationPreference>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
