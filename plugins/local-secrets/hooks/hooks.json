{
  "description": "local-secrets : chiffre les .env au premier accès, masque les secrets dans les sorties, bloque les secrets collés dans le chat",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe",
            "args": ["/d", "/c", "${CLAUDE_PLUGIN_ROOT}\\bin\\hook.cmd", "session-start"],
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe",
            "args": ["/d", "/c", "${CLAUDE_PLUGIN_ROOT}\\bin\\hook.cmd", "user-prompt-submit"],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Edit|MultiEdit|Write|NotebookEdit|Grep|Bash|PowerShell|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe",
            "args": ["/d", "/c", "${CLAUDE_PLUGIN_ROOT}\\bin\\hook.cmd", "pre-tool-use"],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe",
            "args": ["/d", "/c", "${CLAUDE_PLUGIN_ROOT}\\bin\\hook.cmd", "post-tool-use"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
